{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game metadata",
  "type": "object",
  "required": ["game_id", "title"],
  "properties": {
    "game_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "title": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "de": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": true
}

